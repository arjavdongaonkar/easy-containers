DRONE_TAG=2.28.2
DRONE_RPC_SECRET=changeme
DRONE_SERVER_HOST=localhost:8084
DRONE_SERVER_PROTO=http

# Drone server will NOT start without a source-code-management provider.
# Register an OAuth app on your SCM and uncomment ONE block below.
# GitHub:
# DRONE_GITHUB_CLIENT_ID=your_client_id
# DRONE_GITHUB_CLIENT_SECRET=your_client_secret
# Gitea:
# DRONE_GITEA_SERVER=https://gitea.example.com
# DRONE_GITEA_CLIENT_ID=your_client_id
# DRONE_GITEA_CLIENT_SECRET=your_client_secret
